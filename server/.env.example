# Environment Configuration for Lab Record Manager

# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lab_record_manager?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS (optional - for notifications)
SMS_API_KEY=
SMS_SENDER_ID=

# Cloud Storage (optional)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=

# WebRTC/Video Call
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# AI/Gemini (for SQL query generation)
GEMINI_API_KEY=your-gemini-api-key

# Google Drive (5TB Personal Google One OAuth 2.0 & Service Account)
GOOGLE_DRIVE_FOLDER_ID=1fzuxLH580TlkwJyATBbrjv7LBnFnC1Qp
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/drive/auth/callback
GOOGLE_SERVICE_ACCOUNT_EMAIL=ulrms-server@ulrms-481916.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

