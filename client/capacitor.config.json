{
  "appId": "com.labrecmanager.whiteboard",
  "appName": "LabRec Whiteboard",
  "webDir": "native-www",
  "server": {
    "url": "https://ulrms-c.onrender.com",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": ["*"],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true,
    "captureInput": true
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  }
}
